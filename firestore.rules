rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function roleIs(role) {
      return signedIn() && userDoc(request.auth.uid).data.role == role;
    }

    function isAdmin() {
      return roleIs('admin');
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /disposalPoints/{pointId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || isOwner(resource.data.ownerId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.city is string
        && request.resource.data.materials is list;
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerId)
          && request.resource.data.status == resource.data.status
          && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /pickupRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.materials is list;
      allow update: if isAdmin()
        || isOwner(resource.data.donorId)
        || roleIs('collector');
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || isOwner(request.resource.data.donorId)
        || request.resource.data.collectorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.donorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /content/{contentId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
  }
}
